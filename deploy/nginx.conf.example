# Adapt hostname and certificate paths. Validate with nginx -t before reload.
server {
    listen 443 ssl;
    server_name panel.example.invalid;
    ssl_certificate /etc/proxypanel/tls/fullchain.pem;
    ssl_certificate_key /etc/proxypanel/tls/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    root /opt/proxypanel/current/web/dist;
    index index.html;
    client_max_body_size 2m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy no-referrer always;
    add_header X-Frame-Options DENY always;
    # Subscription tokens are bearer secrets: do not log /sub URLs.
    location /sub/ {
        access_log off;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        add_header Cache-Control no-store always;
    }
    location /api/ {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $remote_addr;
        add_header Cache-Control no-store always;
    }
    location /assets/ { try_files $uri =404; }
    location / { try_files $uri $uri/ /index.html; }
    location ~ /\. { deny all; }
}
server {
    listen 80;
    server_name panel.example.invalid;
    return 301 https://$host$request_uri;
}
