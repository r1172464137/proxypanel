# 面板（控制平面）运行镜像。
#
# 单个进程：面板二进制同时提供 API 与前端 SPA。
# 镜像里**不跑 nginx** —— TLS 终止和反向代理由宿主机的 nginx / Caddy 负责。
#
# 构建上下文由 CI 组装，需包含：
#   bin/<arch>/panel   —— CGO_ENABLED=0 交叉编译的 linux 二进制
#   bin/{amd64,arm64}/agent —— 面板一键安装为节点提供的同版 Agent
#   migrations/        —— SQL 迁移（面板启动时按 PANEL_MIGRATIONS_DIR 读取）
#   web/               —— 前端构建产物（npm run build 的 dist 目录内容）
#
# 两种用法：
#
#   A. 面板托管 SPA（默认，PANEL_WEB_ROOT 已设）
#      宿主机 nginx 只需一段 location / { proxy_pass ... } 全量反代。
#      前端与后端同镜像、版本天然一致，宿主机不用维护静态文件目录。
#
#   B. 面板只提供 API（运行时把 PANEL_WEB_ROOT 置空）
#      前端由宿主机 nginx 直接 serve（root 指向你 rsync 过去的 dist）。
#      适合已经有现成静态托管、或想把前端与后端分开发版的场景。
#
# 两种都推荐同一个 HTTPS origin，避免跨域认证与 Cookie 配置。
#
# 为什么面板可以监听 0.0.0.0（而不是像旧版本那样必须回环 + 容器内 nginx）：
# clientIP 只采信回环/私网/链路本地对端的 XFF。仍须把发布端口绑定宿主回环、
# 限制容器网络成员：来源判断不替代网络隔离。容器内监听非回环地址，
# 宿主机 nginx 才能通过 bridge 连进来。
FROM node:22-alpine@sha256:fe4f6d74e20370acb04ad889077d14d0f64a9c8ea6a42bc60cddf1e844699914 AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM alpine:3.23@sha256:85fe1e81d6758c208f3e1eed4338a1997e19d4be002d4dd32d3100c9a8c010a0

# ca-certificates：出站 HTTPS（Telegram 通知）
# tzdata：周期计算需要真实时区数据库
# wget 由 busybox 提供，健康检查用它
RUN apk add --no-cache ca-certificates tzdata \
 && update-ca-certificates

WORKDIR /app

# TARGETARCH 由 buildx 按 --platform 自动注入，用于挑选对应架构的二进制。
ARG TARGETARCH
COPY --chown=65532:65532 bin/${TARGETARCH}/panel /app/panel
COPY --chown=65532:65532 bin/amd64/agent /app/install/agents/linux-amd64/agent
COPY --chown=65532:65532 bin/arm64/agent /app/install/agents/linux-arm64/agent
COPY --chown=65532:65532 deploy/deploy-agent.sh /app/install/deploy-agent.sh
COPY --chown=65532:65532 deploy/install.sh /app/install/install.sh
COPY --chown=65532:65532 deploy/agent /app/install/agent
COPY --chown=65532:65532 migrations /app/migrations
# 前端产物：面板以 65532 身份读取，普通权限即可。
COPY --from=web --chown=65532:65532 /web/dist /usr/share/proxypanel/web

RUN chmod 0755 /app/panel /app/install/deploy-agent.sh /app/install/install.sh /app/install/agent \
    /app/install/agents/linux-amd64/agent /app/install/agents/linux-arm64/agent

# 面板在容器里必须监听所有接口，宿主机 nginx 才能通过容器网络连进来。
# 明文 HTTP 由 PANEL_TRUST_REVERSE_PROXY 显式承认（TLS 在宿主 nginx 终止）。
#
# 不要在这里设 PANEL_TLS_CERT/PANEL_TLS_KEY：那是"面板自己开 TLS"的形态，
# 与"反向代理终止 TLS"是两条互斥路径。面板看到 cert 就会自己在 8080 上开
# TLS，宿主 nginx 用 http:// 反代必然失败。
ENV PANEL_LISTEN=0.0.0.0:8080 \
    PANEL_TRUST_REVERSE_PROXY=true \
    PANEL_MIGRATIONS_DIR=/app/migrations \
    PANEL_WEB_ROOT=/usr/share/proxypanel/web \
    PANEL_AGENT_INSTALLER_PATH=/app/install/deploy-agent.sh \
    PANEL_AGENT_BINARY_AMD64=/app/install/agents/linux-amd64/agent \
    PANEL_AGENT_BINARY_ARM64=/app/install/agents/linux-arm64/agent

# 8080 是容器端口。对外暴露的 443 由宿主机 nginx 提供，不在这个镜像里。
EXPOSE 8080

# 非特权用户运行（65532:65532）。面板不需要绑定特权端口、不需要写文件系统。
USER 65532:65532

HEALTHCHECK --interval=15s --timeout=5s --start-period=20s --retries=3 \
  CMD wget -q -O- http://127.0.0.1:8080/healthz || exit 1

ENTRYPOINT ["/app/panel"]
