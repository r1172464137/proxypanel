# proxypanel 一体化部署的配置模板。
#
#   cp deploy/.env.bundle.example .env && ${EDITOR:-vi} .env
#
# 下面三个值生成一次之后就要固定保存：更换 PANEL_MASTER_KEY 会让数据库里已有的
# 成员凭据（密码与 UUID）无法解密，且不可逆。
#
#   openssl rand -hex 32      # PG_PASSWORD
#   openssl rand -hex 32      # REDIS_PASSWORD
#   openssl rand -base64 32   # PANEL_MASTER_KEY（必须是 32 字节的 base64）
#
# 不要把 .env 提交到仓库。

# --- 必填 ---------------------------------------------------------------
PG_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
PANEL_MASTER_KEY=CHANGE_ME

# 浏览器访问面板用的地址。必须是 https 且与证书域名一致：
# 它决定 CSRF 校验和订阅链接中的主机名。
#   https://panel.example.com
#   https://192.168.5.203:8443   （直接用 IP 时必须把 IP 写进证书 SAN）
PANEL_PUBLIC_URL=https://CHANGE_ME:8443

# --- 可选 ---------------------------------------------------------------
# 镜像标签：latest / main / sha-<短哈希> / v1.2.3
PANEL_TAG=latest

# 仅在用户表为空时使用（首次启动）。登录成功后把这行删掉。
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=

# 面板发布到宿主的哪个地址。203 有公网 IP，所以默认只绑内网网卡。
# 改成 127.0.0.1 就只允许本机访问（配合 SSH 隧道使用）。
PANEL_BIND_IP=192.168.5.203

# --- 前后端分离部署（可选）---------------------------------------------
# 默认留空 = 同源部署，行为与改造前完全一致。
# 只有当浏览器地址与面板地址不同时才需要配置下面几项。

# 允许跨域访问面板的前端地址（逗号分隔）。留空表示不启用 CORS。
# 注意：带凭据的跨域请求不能用 "*"，这里必须写精确的协议+主机+端口。
#   PANEL_ALLOWED_ORIGINS=https://panel.example.com
PANEL_ALLOWED_ORIGINS=

# 会话 Cookie 的 SameSite 策略：strict（默认）| lax | none。
#   同主域子域（panel.a.com + api.a.com）→ lax 即可
#   完全不同域名（a.com + b.net）        → 必须 none
# SameSite=none 要求 Secure，且不能与 PANEL_DEV=true 同时使用（启动时会报错）。
PANEL_COOKIE_SAMESITE=strict

# 允许同主域子域共享会话，例如 .example.com。默认空（仅当前主机）。
PANEL_COOKIE_DOMAIN=
