# Copy to /etc/proxypanel/panel.env, chmod 0600; never commit real values.
DATABASE_URL=postgres://proxypanel:REPLACE@127.0.0.1:5432/proxypanel?sslmode=disable
REDIS_URL=redis://default:REPLACE@127.0.0.1:6379/0
# Generate a random 32-byte master key and retain separately from the database.
PANEL_MASTER_KEY=REPLACE_WITH_RANDOM_32_BYTE_BASE64_KEY
PANEL_LISTEN=127.0.0.1:8080
PANEL_PUBLIC_URL=https://panel.example.invalid
PANEL_DEV=false
PANEL_TRUST_REVERSE_PROXY=true
PANEL_MIGRATIONS_DIR=/opt/proxypanel/current/migrations
# Bootstrap only when the members table is empty. Remove after first start.
PANEL_ADMIN_USER=admin
PANEL_ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_STRONG_PASSWORD
# Alternative direct HTTPS: disable reverse proxy mode and set both paths.
# PANEL_TLS_CERT=/etc/proxypanel/tls/fullchain.pem
# PANEL_TLS_KEY=/etc/proxypanel/tls/privkey.pem
